# Copia este archivo a .env.local y rellena los valores.
# cp .env.example .env.local

# --- Almacén (Vercel KV / Upstash Redis) -----------------------------------
# Sin estas variables la app arranca en modo memoria (no persistente, solo dev).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Admin ------------------------------------------------------------------
ADMIN_TOKEN=

# --- Dominio público (JSON-LD, sitemap, robots.txt) --------------------------
# Sin esta variable se usa VERCEL_URL o, en su defecto, el dominio de Vercel
# del proyecto — cámbialo al dominio definitivo cuando esté listo.
NEXT_PUBLIC_SITE_URL=

# --- Cron de retención de datos (/api/cron/retention) -------------------------
# Vercel añade automáticamente la cabecera Authorization con este valor al
# invocar el cron (ver vercel.json). Sin esta variable, el endpoint rechaza
# cualquier petición — un lead que nunca se ha convertido en cliente se
# anonimiza pasados 24 meses de inactividad (política de retención, ver /legal).
CRON_SECRET=

# --- Contacto / marca ---------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=34600000000
NEXT_PUBLIC_CONTACT_HOURS=L–V · 9:00–20:00 (hora canaria)
NEXT_PUBLIC_CALLER_1=
NEXT_PUBLIC_CALLER_2=

# --- Webhook saliente opcional (leads a un sistema externo) ------------------
LEAD_WEBHOOK_URL=

# --- Retell AI (llamada automática del agente de voz al completar el tarificador) ---
# Sin estas tres variables, la llamada automática queda desactivada sin más.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# --- Bland.ai (llamada automática al completar el tarificador o pedir llamada) ---
# Sin las dos primeras, la llamada automática queda desactivada sin más.
# ⚠️ No actives Retell y Bland a la vez: el mismo lead recibiría dos llamadas.
BLAND_API_KEY=
BLAND_PATHWAY_ID=
BLAND_WEBHOOK_SECRET=

# --- Resend (email de verificación para entrar al área de cliente) ---------
# Crea una cuenta gratuita en https://resend.com, verifica tu dominio (o usa
# el remitente de pruebas onboarding@resend.dev mientras tanto) y genera una
# API key. Sin RESEND_API_KEY, el acceso al área de cliente desde una ficha
# YA EXISTENTE queda desactivado por defecto (comportamiento seguro: mejor
# sin acceso automático que con uno sin verificar) — el acceso automático
# justo después de tarificar por primera vez sigue funcionando igual.
RESEND_API_KEY=
EMAIL_FROM=Asegurados Ventajon <no-reply@tudominio.com>

# --- Meta Conversions API (evento "Lead" servidor a servidor) ---------------
# El ID del píxel se configura desde /admin/configuracion/analitica (no es
# secreto). Este token sí lo es: Meta Business Suite → Administrador de
# eventos → tu píxel → Configuración → Conversions API → "Generar token de
# acceso manualmente". Sin esta variable, el píxel de cliente sigue
# funcionando igual (PageView/remarketing); solo se desactiva el envío
# server-side del evento de conversión.
META_CAPI_ACCESS_TOKEN=

# --- ManyChat (WhatsApp: resumen tras tarificar y enlace de verificación) ---
# ManyChat → Configuración → API para el token. Sin MANYCHAT_API_TOKEN, todo
# el envío por WhatsApp queda desactivado sin más (no-op, no rompe el resto).
MANYCHAT_API_TOKEN=
# (opcional) flow_ns de un Flow de ManyChat que envíe, con una plantilla de
# WhatsApp aprobada por Meta, el resumen del presupuesto justo tras tarificar
# (necesario fuera de las 24h de sesión de WhatsApp Business). Sin esta
# variable, ese mensaje de resumen simplemente no se envía.
MANYCHAT_THANKYOU_FLOW_NS=
# (opcional) igual que la anterior pero para el enlace de un solo uso que
# permite entrar al área de cliente por WhatsApp cuando el email no llega o
# el cliente lo prefiere (botón "Reenviar por WhatsApp" en /area-cliente).
# Requiere en ManyChat: 1) un custom field "link_verificacion", 2) una
# plantilla de WhatsApp aprobada que lo use, 3) un Flow que la envíe — copia
# aquí su flow_ns. Sin esta variable, ese botón simplemente falla con un
# aviso y el cliente puede seguir usando el email o escribir directamente.
MANYCHAT_VERIFICATION_FLOW_NS=

# --- Cloudflare Turnstile (CAPTCHA en formularios que disparan llamadas) ----
# Crea un site en https://dash.cloudflare.com/?to=/:account/turnstile (modo
# "Managed", normalmente invisible para un usuario real). Sin estas dos
# variables, los formularios funcionan igual mostrando el rate limiting como
# única defensa (ver lib/rateLimit.ts).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
