# Copia este archivo a .env.local y rellena los valores.
# cp .env.example .env.local

# --- Almacén (Vercel KV / Upstash Redis) -----------------------------------
# Sin estas variables la app arranca en modo memoria (no persistente, solo dev).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Admin ------------------------------------------------------------------
ADMIN_TOKEN=

# --- Contacto / marca ---------------------------------------------------------
NEXT_PUBLIC_WHATSAPP_NUMBER=34600000000
NEXT_PUBLIC_CONTACT_HOURS=L–V · 9:00–20:00 (hora canaria)
NEXT_PUBLIC_CALLER_1=
NEXT_PUBLIC_CALLER_2=

# --- Webhook saliente opcional (leads a un sistema externo) ------------------
LEAD_WEBHOOK_URL=

# --- Retell AI (llamada automática del agente de voz al completar el tarificador) ---
# Sin estas tres variables, la llamada automática queda desactivada sin más.
RETELL_API_KEY=
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=

# --- Bland.ai (llamada automática al completar el tarificador o pedir llamada) ---
# Sin las dos primeras, la llamada automática queda desactivada sin más.
# ⚠️ No actives Retell y Bland a la vez: el mismo lead recibiría dos llamadas.
BLAND_API_KEY=
BLAND_PATHWAY_ID=
BLAND_WEBHOOK_SECRET=
